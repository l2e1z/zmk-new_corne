#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10
#define COLOR_RED RGB_COLOR_HSB(0, 100, 50)

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    macros {
        // レイヤー4へ移動し、LEDをONにして赤くする

        to_l4_red: to_l4_red {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 4 &rgb_ug COLOR_RED &rgb_ug RGB_ON>;
        };

        // レイヤー0(通常)に戻り、LEDをOFFにする

        to_l0_off: to_l0_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &rgb_ug RGB_OFF>;
        };

        // 【追加】レイヤー5へ移動し、LEDをONにして青くする（1秒後に自動消灯）

        to_l5_blue: to_l5_blue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 5>;
        };

        // 【追加】レイヤー7へ移動し、LEDをONにして紫にする（1秒後に自動消灯）

        to_l7_purple: to_l7_purple {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 7>;

            // <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(290, 100, 50)>,
            // <&macro_wait_time 1000>,
            // <&rgb_ug RGB_OFF>;
        };

        // 【追加】レイヤー8へ移動し、LEDをONにしてオレンジにする（1秒後に自動消灯）

        to_l8_orange: to_l8_orange {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 8 &rgb_ug RGB_COLOR_HSB(10, 100, 50) &rgb_ug RGB_ON>;

            // <&macro_wait_time 3000>,
            // <&rgb_ug RGB_OFF>;
        };
    };

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        td_to_layer8: td_to_layer8 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TO_LAYER8";
            #binding-cells = <0>;
            bindings = <&none>, <&to_l8_orange>;

            tapping-term-ms = <200>;
        };

        // 既存の &lt の挙動自体をホールド優先に上書き

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <>;
        };

        task_manager {
            bindings = <&kp LS(LC(ESCAPE))>;
            key-positions = <0 13 28 43>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R  &kp T                               &kp UP                &kp Y        &kp U        &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LCTRL       &kp A  &kp S  &kp D         &kp F  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J        &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V  &kp B        &kp SPACE              &kp DOWN              &kp N        &kp M        &kp COMMA      &kp DOT  &kp FSLH  &lt 7 INT_YEN
                              &kp LEFT_ALT  &mo 1  &lt 3 SPACE                                               &lt 3 SPACE  &lt 2 SPACE  &td_to_layer8
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        MOVE_LAYER {
            display-name = "MOVE";
            bindings = <
&kp ESC  &kp HOME         &kp DEL         &kp UP        &kp BACKSPACE    &kp END                                  &mmv MOVE_UP                     &mkp LCLK  &kp PG_UP         &kp UP_ARROW        &kp BACKSPACE  &none      &kp BSPC
&trans   &kp RC(A)        &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp ENTER                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp HOME   &kp LEFT          &kp DOWN            &kp RIGHT      &kp ENTER  &kp END
&trans   &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &mkp MCLK     &msc SCRL_UP     &kp RC(B)  &kp C_MUTE                    &mmv MOVE_DOWN                   &kp RC(N)  &kp PAGE_DOWN     &kp LS(LEFT_ARROW)  &kp LS(RIGHT)  &none      &none
                                          &kp LEFT_WIN  &trans           &kp ENTER                                                                 &kp ENTER  &kp INT_MUHENKAN  &kp INT_HENKAN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        SYMBOL_LAYER {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp AMPERSAND  &kp AT    &kp UNDER   &kp LEFT_BRACE       &kp LS(EQUAL)                                &mmv MOVE_UP                     &kp EQUAL          &kp LS(INTERNATIONAL_1)  &kp MINUS              &none                &kp PERCENT              &kp BSPC
&trans  &kp CARET      &kp HASH  &kp DOLLAR  &none                &kp RIGHT_BRACKET            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp RIGHT_BRACKET  &kp ASTRK                &kp LESS_THAN          &kp GREATER_THAN     &kp LEFT_PARENTHESIS     &kp NON_US_HASH
&trans  &none          &kp EXCL  &none       &kp INTERNATIONAL_3  &kp BACKSLASH      &trans                    &mmv MOVE_DOWN                   &kp UNDER          &kp PLUS                 &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp LS(INTERNATIONAL_3)  &kp LS(INT_YEN)
                                 &trans      &trans               &kp SPACE                                                                     &kp RET            &trans                   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        NUM_LAYER {
            display-name = "Fn&NUM";
            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                                      &mmv MOVE_UP                     &kp F6         &kp F7  &kp F8  &kp F9  &kp F10          &kp F11
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp BACKSPACE  &trans  &trans  &trans  &kp PRINTSCREEN  &kp F12
&trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0        &kp C_MUTE                    &mmv MOVE_DOWN                   &trans         &trans  &trans  &trans  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                    &trans        &trans        &trans                                                                       &trans         &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        SYSTEM_LAYER {
            display-name = "SYSTEM";
            bindings = <
&none  &soft_off     &none         &bootloader   &sys_reset    &bt BT_CLR_ALL                       &none         &sys_reset       &none            &none            &kp LC(V)        &rgb_ug RGB_OFF  &rgb_ug RGB_ON
&none  &bt BT_NXT    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                  &none  &none  &none  &bootloader      &none            &none            &soft_off        &rgb_ug RGB_SPI  &rgb_ug RGB_BRI
&none  &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &none         &bt BT_CLR      &kp C_MUTE           &none         &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD
                                   &none         &none         &to_l0_off                                         &to_l0_off       &none            &none
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };

        GAME_QWERTY {
            display-name = "GAME_QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                             &kp UP                &kp Y        &kp U                  &kp I          &kp O    &kp P     &kp AT
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J                  &kp K          &kp L    &kp SEMI  &kp COLON
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp SPACE              &kp DOWN              &kp N        &kp M                  &kp COMMA      &kp DOT  &kp FSLH  &lt 7 INTERNATIONAL_3
                         &kp LALT  &mo 6  &kp SPACE                                               &lt 3 SPACE  &lt 2 INTERNATIONAL_4  &kp RIGHT_ALT
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };

        GAME_NUM {
            display-name = "GAME_NUM";
            bindings = <
&kp ESC  &kp N2  &kp NUMBER_3  &trans  &kp NUMBER_4  &kp N5                    &trans          &none     &trans               &trans          &trans  &trans  &trans
&trans   &kp N1  &trans        &trans  &trans        &trans            &trans  &trans  &trans  &kp BSPC  &trans               &trans          &trans  &trans  &trans
&trans   &trans  &kp N7        &kp N8  &kp N9        &kp N0  &trans            &trans          &trans    &trans               &trans          &trans  &trans  &to_l0_off
                               &trans  &trans        &trans                                    &trans    &kp INTERNATIONAL_5  &kp INT_HENKAN
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };

        MOD_LAYER {
            display-name = "Mod";
            bindings = <
&none  &none  &none  &none  &none  &none                       &none         &kp LC(LA(DELETE))  &none       &none        &none  &none               &kp C_VOLUME_UP
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none               &none       &none        &none  &kp C_MUTE          &kp C_VOL_DN
&none  &none  &none  &none  &none  &none  &kp C_MUTE           &none         &to_l0_off          &none       &none        &none  &kp RC(LEFT_ARROW)  &none
                     &none  &none  &to 0                                     &to_l4_red          &to_l0_off  &to_l5_blue
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };

        MOUSE_LAYER {
            display-name = "MOUSE";
            bindings = <
&kp TAB            &kp N6  &kp N7  &kp N8     &kp N9    &kp N0                           &msc SCRL_UP                     &msc SCRL_UP    &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &none           &kp BACKSPACE
&none              &kp N1  &kp N2  &kp N3     &kp N4    &kp N5           &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp UP_ARROW    &none
&kp LS(BACKSPACE)  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0  &none                    &msc SCRL_DOWN                   &msc SCRL_LEFT  &msc SCRL_RIGHT  &mkp MCLK       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT
                                   &kp MINUS  &kp FSLH  &none                                                             &none           &none            &to_l0_off
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };
    };
};
